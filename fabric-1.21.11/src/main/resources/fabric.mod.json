{
	"schemaVersion": 1,
	"id": "neko-translator",
	"version": "${version}",
	"name": "Neko Translator",
	"description": "${description}",
	"authors": [
		"SmallZombie"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/neko-translator",
		"issues": "https://github.com/SmallZombie/neko-translator/issues",
		"sources": "https://github.com/SmallZombie/neko-translator"
	},
	"license": "GPL-3.0",
	"icon": "assets/neko-translator/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "me.avgt.s9e.NekoTranslator",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "me.avgt.s9e.client.NekoTranslatorClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"neko-translator.mixins.json",
		{
			"config": "neko-translator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
