{
	"schemaVersion": 1,
	"id": "neko-translator",
	"version": "${version}",
	"name": "Neko Translator",
	"description": "Chat translation with a clickable [T] marker, local OpenAI-compatible API settings and optional peer-to-peer translation through players you trust.",
	"authors": [
		"Neko"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "CC0-1.0",
	"icon": "assets/neko-translator/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "me.avgt.s9e.NekoTranslator",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "me.avgt.s9e.client.NekoTranslatorClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"neko-translator.mixins.json",
		{
			"config": "neko-translator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
